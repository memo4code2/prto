{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Dynamic back-end developer portfolio (HTML5, SCSS, Bootstrap, vanilla JS)",
  "scripts": {
    "build:css": "sass --style=compressed --no-source-map src/scss/main.scss css/main.css",
    "watch:css": "sass --watch --no-source-map src/scss/main.scss css/main.css",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
